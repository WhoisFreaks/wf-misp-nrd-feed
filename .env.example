# Environment overrides. Anything set here wins over config.ini.
# Copy to .env (already gitignored) or export in your service unit.

NRD_API_KEY=your_whoisfreaks_api_key_here

# NRD_BASE_URL=https://files.whoisfreaks.com/v3.1/download/domainer
# NRD_FEEDS=gtld,cctld
# NRD_RETENTION_DAYS=7
# NRD_CACHE_DIR=/var/cache/misp-nrd-feed
# MISP_FEED_DIR=/var/lib/misp-nrd-feed/feed
# MISP_ORG_NAME=WhoisFreaks
# MISP_UUID_NAMESPACE=b0f1e2c3-4d5a-4b6c-8d7e-9f0a1b2c3d4e
# MISP_TO_IDS=false
# MISP_DISABLE_CORRELATION=true
# MISP_TAGS=tlp:clear;whoisfreaks:feed="nrd"
# NRD_LOG_LEVEL=INFO

# --- Domain Threat Feeds (phishing / malware / spam), off by default ---
# THREAT_ENABLED=true
# THREAT_BASE_URL=https://files.whoisfreaks.com/v3.4/download/threat-feed
# THREAT_TYPES=phishing,malware,spam
# THREAT_FEED_DIR=/var/lib/misp-nrd-feed/threat-feed
# THREAT_MIN_CONFIDENCE=0.0
# THREAT_TO_IDS=true
# THREAT_DISABLE_CORRELATION=false